# Apache / XAMPP Rewrite Configuration for Nexyra Hackathon

Options -Indexes
RewriteEngine On

# Pass through existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route API endpoints cleanly
RewriteRule ^api/register/?$ api/register.php [L,QSA]
RewriteRule ^api/registrations/?$ api/registrations.php [L,QSA]
